{
  "name": "aroma-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "dev:web": "pnpm --filter @aroma/web dev",
    "build:web": "pnpm --filter @aroma/web build",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @aroma/web db:generate",
    "db:migrate": "pnpm --filter @aroma/web db:migrate",
    "test:anchor": "pnpm --filter @aroma/anchor test",
    "build:anchor": "cd packages/anchor && anchor build"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "tsx": "4.20.6",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "overrides": {
      "tar@>=6 <7.5.21": "7.5.21",
      "@xmldom/xmldom@<0.8.15": "0.8.15",
      "postcss@>=8 <8.5.23": "8.5.28",
      "viem@2>ws@>=8 <8.21.0": "8.21.3",
      "axios@>=1 <1.18.0": "1.18.0"
    }
  },
  "engines": {
    "node": ">=24.12.0",
    "pnpm": ">=10.31.0"
  }
}
