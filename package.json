{
  "name": "ovelo-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=24.12.0",
    "pnpm": ">=10.31.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @ovelo/web dev",
    "build:web": "pnpm --filter @ovelo/web build",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @ovelo/web db:generate",
    "db:migrate": "pnpm --filter @ovelo/web db:migrate",
    "check:prod-env": "pnpm --filter @ovelo/web check:prod-env",
    "check:custody": "pnpm --filter @ovelo/web check:custody",
    "build:contracts": "pnpm --filter @ovelo/contracts build",
    "test:contracts": "pnpm --filter @ovelo/contracts test:native && pnpm --filter @ovelo/contracts test:clippy && pnpm --filter @ovelo/contracts build && pnpm --filter @ovelo/contracts idl:check && pnpm --filter @ovelo/contracts test && pnpm --filter @ovelo/contracts test:fixtures && pnpm --filter @ovelo/contracts test:fixtures:mainnet && pnpm --filter @ovelo/contracts test:litesvm && pnpm --filter @ovelo/contracts test:litesvm:subscriptions-mainnet"
  },
  "devDependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "prettier": "^3.6.2",
    "tsx": "4.20.6",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "overrides": {
      "tar@>=6 <7.5.21": "7.5.21",
      "@xmldom/xmldom@<0.8.15": "0.8.15",
      "postcss@>=8 <8.5.23": "8.5.28",
      "viem@2>ws@>=8 <8.21.0": "8.21.3",
      "axios@>=1 <1.18.0": "1.18.0",
      "sharp@<0.35.5": "0.35.5",
      "source-map-js@<1.2.2": "1.2.2",
      "shell-quote@<1.11.0": "1.11.0",
      "image-size@<2.0.3": "2.0.3",
      "brace-expansion@<1.1.20": "1.1.20",
      "node-forge@<1.4.1": "1.4.1"
    }
  }
}
