{
  "name": "@aroma/config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared tsconfig, ESLint 9 flat config, Prettier config and Vitest preset for the Aroma monorepo.",
  "exports": {
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./eslint": "./eslint/index.js",
    "./prettier": "./prettier.config.mjs",
    "./vitest": {
      "types": "./vitest.preset.d.mts",
      "default": "./vitest.preset.mjs"
    },
    "./max-lines-allowlist.json": "./max-lines-allowlist.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "allowlist": "node scripts/gen-max-lines-allowlist.mjs"
  },
  "dependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "15.5.29",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript-eslint": "8.72.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "eslint": "9.39.5",
    "typescript": "^5.7.3",
    "vitest": "3.2.7"
  },
  "peerDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.6.0",
    "vitest": "^3.2.0"
  }
}
