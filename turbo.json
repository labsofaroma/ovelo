{
  "$schema": "https://turbo.build/schema.json",
  "envMode": "loose",
  "globalDependencies": ["pnpm-lock.yaml", ".nvmrc"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "NEXT_PUBLIC_*",
        "AROMA_*",
        "SOLANA_RPC_URL",
        "SOLANA_RPC_FALLBACK_URL",
        "DATABASE_URL",
        "UPSTASH_*",
        "QSTASH_*",
        "SENTRY_*",
        "LOG_LEVEL",
        "JUPITER_API_KEY",
        "PYTH_API_KEY",
        "PRIVY_APP_SECRET",
        "CREATOR_*",
        "KEEPER_*",
        "JITO_*",
        "BOT_KEYPAIR",
        "VERCEL_ENV"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env.example"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
