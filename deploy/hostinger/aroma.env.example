# /etc/aroma/aroma.env: the app's runtime environment on the VPS (Phase H; SELF-HOST.md §2).
# TEMPLATE ONLY: no values here. On the VPS:  sudo install -m 0600 -o root -g root ... /etc/aroma/aroma.env
# Generate each SECRET on the owner's machine (`openssl rand -base64 48`), never paste one into chat,
# a ticket or shell history. No quotes around values: docker --env-file takes them literally.
# Validate before every deploy:
#   pnpm check:prod-env --env-file <file> --profile beta|production --platform selfhost
# Lines marked SECRET must stay secret; the others are configuration.

# ── Platform and edge (server/platform.ts, server/proxy.ts) ──
AROMA_PLATFORM=selfhost
# beta for beta.<domain>, production for the production domain.
AROMA_DEPLOY_ENV=
AROMA_PROXY_MODE=cloudflare
# SECRET. Exactly the value the Cloudflare Transform Rule sets as x-aroma-origin. 32+ chars, unique.
AROMA_ORIGIN_SECRET=

# ── Site ──
# https://beta.<domain> or https://<domain> (no trailing slash).
AROMA_SITE_URL=
AROMA_ALLOWED_ORIGINS=
AROMA_OPERATOR_NAME=
AROMA_SUPPORT_EMAIL=
LOG_LEVEL=info

# ── Emergency stop (kill-switch.md) ──
AROMA_TRADING=on
# Solana Actions (Blinks) POST. Unset = off here: a Blink client may call it from its own servers,
# so the geo gate sees the client's country. Set on only after counsel agrees (COMPLIANCE.md §1).
AROMA_ACTIONS=

# ── Chain (mainnet; read-only calls and user-signed broadcasts only) ──
# SECRET when the URL embeds a provider key.
SOLANA_RPC_URL=
# SECRET when the URL embeds a provider key. A second provider (PRODUCTION-ENV §3).
SOLANA_RPC_FALLBACK_URL=

# ── Data (managed: Neon, Upstash) ──
# SECRET. The aroma_app role (DML only). The migration role goes in migrate.env, never here.
DATABASE_URL=
UPSTASH_REDIS_REST_URL=
# SECRET.
UPSTASH_REDIS_REST_TOKEN=

# ── Trading ──
# SECRET. Signs trade authorizations. Rotation: KEY-CUSTODY.md (set the old one as _PREVIOUS).
AROMA_TRADE_SECRET=
# SECRET (only during a rotation).
AROMA_TRADE_SECRET_PREVIOUS=
# Raw USDC units (6 decimals). Required in production and beta.
AROMA_MAX_TRADE_USDC_RAW=
AROMA_MAX_DAILY_USDC_RAW=
# SECRET.
JUPITER_API_KEY=
JITO_BLOCK_ENGINE_URL=
# SECRET.
JITO_AUTH_UUID=
JITO_MAX_TIP_LAMPORTS=
AROMA_PLATFORM_FEE_BPS=
AROMA_CREATOR_FEE_SHARE_BPS=

# ── Gates ──
AROMA_BETA_GATE=
AROMA_BETA_WALLETS=
AROMA_COMPLIANCE_RESTRICTED_COUNTRIES=
# Production keeps block (check:prod-env refuses allow).
AROMA_COMPLIANCE_MISSING_COUNTRY=block
AROMA_COMPLIANCE_BROWSE=
AROMA_COMPLIANCE_DEVNET=
AROMA_TERMS_VERSION=
# Until counsel's final terms are in features/compliance/terms.ts the boot refuses production.
# A beta (AROMA_DEPLOY_ENV=beta) may run on the placeholder with this set to true; never in production.
AROMA_ALLOW_PLACEHOLDER_TERMS=

# ── Notifications (M11; QStash calls the public, signed worker route) ──
AROMA_NOTIFICATIONS=
# SECRET.
AROMA_NOTIFY_WORKER_SECRET=
VAPID_PUBLIC_KEY=
# SECRET.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# SECRET.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# SECRET.
TELEGRAM_WEBHOOK_SECRET=
# SECRET.
QSTASH_TOKEN=
# SECRET.
QSTASH_CURRENT_SIGNING_KEY=
# SECRET.
QSTASH_NEXT_SIGNING_KEY=

# ── Observability and ops ──
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# SECRET.
AROMA_REVALIDATE_SECRET=
# SECRET.
PYTH_API_KEY=

# ── Devnet test surface (test funds only; never a mainnet key) ──
AROMA_RECURRING_RPC_URL=https://api.devnet.solana.com
AROMA_V1_INVEST_CLUSTER=devnet
# SECRET (devnet-only key).
AROMA_V1_FAUCET_KEYPAIR=
AROMA_V1_FAUCET_DAILY_CLAIMS=
# SECRET (a real Turnstile secret; the test secrets are refused).
TURNSTILE_SECRET_KEY=

# NEVER here: SENTRY_AUTH_TOKEN, AROMA_TRUST_PROXY, AROMA_SKIP_ENV_CHECK, AROMA_V1_TEST_*,
# AROMA_V1_LOCALNET_*, AROMA_LOCAL_NEON_WS_PROXY, NEXT_PUBLIC_AROMA_E2E_WALLET, any funded keypair.
# NEXT_PUBLIC_* values are baked into the image at build (CI repository variables), not set here.
# The image carries them (deploy/public-env.json) and applies them at startup; a value set here
# is ignored with a startup log line naming it, because the browser bundle uses the build value.
