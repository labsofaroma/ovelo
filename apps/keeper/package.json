{
  "name": "@ovelo/keeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ovelo Guard v1 keeper: a stateless POST /run handler, triggered by QStash, that executes due recurring-plan installments on devnet with fresh, fully verified Pyth prices.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start": "tsx src/server.ts",
    "cli": "tsx src/cli.ts"
  },
  "devDependencies": {
    "@ovelo/config": "workspace:*",
    "@electric-sql/pglite": "0.5.16",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "fast-check": "4.10.2",
    "tsx": "4.20.6",
    "typescript": "^5.7.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@ovelo/guard": "workspace:*",
    "@neondatabase/serverless": "1.2.0",
    "@solana/kit": "7.1.1",
    "@upstash/redis": "1.41.0",
    "drizzle-orm": "0.45.4",
    "pino": "10.4.0",
    "zod": "4.6.7"
  }
}
