{
  // New-code project: stricter than the prototype config. Legacy files must not be imported here
  // (tsc would check them under these flags too); use narrow imports or local constants.
  "extends": "@aroma/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "preserve",
    "types": ["node"],
    "paths": {
      // TEMPORARY (M3-SDK-REQUESTS #1): lib/sdk/research/bars.ts is not strict-clean yet.
      "@/lib/sdk/research/service": [
        "./features/stock/research-service.strict.d.ts"
      ],
      "@/*": ["./*"]
    }
  },
  "include": [
    "observability/**/*.ts",
    "instrumentation-client.ts",
    "server/**/*.ts",
    "lib/sdk/core/**/*.ts",
    "lib/sdk/pyth/**/*.ts",
    "lib/sdk/jupiter/**/*.ts",
    "lib/sdk/markets/**/*.ts",
    "lib/sdk/research/**/*.ts",
    "lib/sdk/baskets/**/*.ts",
    "lib/sdk/paper/**/*.ts",
    "lib/sdk/trade/**/*.ts",
    "instrumentation*.ts",
    "sentry.*.ts",
    "scripts/check-env.ts",
    "drizzle.config.ts",
    "vitest.config.ts",
    "app/api/v1/**/*.ts",
    "app/(app)/**/*.{ts,tsx}",
    "app/(marketing)/**/*.{ts,tsx}",
    "features/**/*.{ts,tsx}",
    "e2e/**/*.ts"
  ],
  "exclude": ["lib/sdk/**/*.test.ts", "lib/sdk/jupiter/test-fixtures.ts"]
}
