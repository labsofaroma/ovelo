{
  // New-code project: stricter than the prototype config. Legacy files must not be imported here
  // (tsc would check them under these flags too); use narrow imports or local constants.
  "extends": "@aroma/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "preserve",
    "types": ["node"],
    "paths": { "@/*": ["./*"] }
  },
  "include": [
    "observability/**/*.ts",
    "instrumentation-client.ts",
    "server/**/*.ts",
    "lib/sdk/core/**/*.ts",
    "lib/sdk/pyth/**/*.ts",
    "lib/sdk/jupiter/**/*.ts",
    "lib/sdk/markets/**/*.ts",
    "lib/sdk/research/**/*.ts",
    "lib/sdk/baskets/**/*.ts",
    "lib/sdk/paper/**/*.ts",
    "lib/sdk/trade/**/*.ts",
    // M7: the v1 contract client is `@aroma/guard`; this path only re-exports it.
    "lib/sdk/guard/v1/**/*.ts",
    "instrumentation*.ts",
    "sentry.*.ts",
    "scripts/check-env.ts",
    "drizzle.config.ts",
    "vitest.config.ts",
    "app/api/v1/**/*.ts",
    // TypeScript's `include` has no brace expansion: "*.{ts,tsx}" matched nothing, so these
    // folders were only checked when imported from elsewhere. One pattern per extension.
    "app/(app)/**/*.ts",
    "app/(app)/**/*.tsx",
    "app/(marketing)/**/*.ts",
    "app/(marketing)/**/*.tsx",
    "features/**/*.ts",
    "features/**/*.tsx",
    "e2e/**/*.ts"
  ],
  "exclude": ["lib/sdk/**/*.test.ts", "lib/sdk/jupiter/test-fixtures.ts"]
}
