{
  // Tests converted mechanically from the untyped node:test suites (scripts/node-test-to-vitest.ts).
  // Their fixtures are partial objects and untyped mocks, so strictNullChecks and noImplicitAny are
  // off here. Everything else stays on: wrong imports, property names and call signatures still fail.
  // Tests written from scratch are NOT listed here; they are checked by tsconfig.json in full.
  // Shrink this list as fixtures are typed. tsconfig.json excludes the same files.
  // The 8 converted files that M2 left outside tsc entirely (M2 decision 5) were typed in M4 (Part
  // A4) with the builders in lib/sdk/markets/test-fixtures.ts and are now checked by tsconfig.json
  // in full (strict), not by this relaxed project.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strictNullChecks": false,
    "noImplicitAny": false,
    "incremental": false,
    "tsBuildInfoFile": null
  },
  "include": [
    "next-env.d.ts",
    "lib/sdk/research/client.test.ts",
    "lib/sdk/research/pulse.test.ts",
    "lib/sdk/research/service.test.ts",
    "lib/sdk/research/cache.test.ts",
    "lib/sdk/research/enrichment.test.ts",
    "lib/sdk/baskets/rebalance.test.ts"
  ],
  "exclude": ["node_modules"]
}
