# Aroma environment. Copy to .env.local and fill in real values. Never commit real values.
# Every value below is a PLACEHOLDER: it passes validation (server/env.schema.ts) but connects to nothing
# (hosts use the reserved .invalid TLD, which can never resolve).
# Validation fails fast at boot and in `pnpm build:web` with a list of variable NAMES only (never values).
# Blank optional variables count as unset.

# ───────── Feature flag ─────────
# Master switch for the v1 foundation (REWRITE-PLAN M0). While false or unset (the deployed
# prototype), the variables marked "required for v1" below are not enforced and boot validation is skipped.
# Set to true to require them, validate at boot, and make /api/v1/health report their status.
AROMA_V1_ENABLED=true

# ───────── Public (browser-visible; never put secrets here) ─────────
# Optional public Privy app ID. Enable Solana embedded wallets in the Privy dashboard.
NEXT_PUBLIC_PRIVY_APP_ID=
# Public client RPC endpoint; it must be Solana mainnet. Use a browser-safe, origin-restricted key. HTTPS only.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional matching browser WebSocket endpoint for Privy (wss://).
NEXT_PUBLIC_SOLANA_WS_URL=
# Optional Plausible site domain. Public identifier, not an API key.
# Analytics requests only start after visitor consent; must match the site hostname.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional Sentry DSN for the browser. Public by design. Blank disables Sentry in the browser (no-op).
# Events are scrubbed of user identity, IPs, cookies, request bodies and wallet addresses before sending.
NEXT_PUBLIC_SENTRY_DSN=

# ───────── Server ─────────
# fatal | error | warn | info | debug | trace | silent. Structured JSON logs (pino); secrets are redacted.
LOG_LEVEL=info
# Server-side mainnet RPC for balances, transaction preparation, simulation and broadcast. Required for v1.
# HTTPS only, no embedded credentials, must not look like devnet/testnet. The genesis hash is verified at runtime.
# The public default is for development; configure provider quotas for a public demo.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Neon Postgres connection string (pooled, sslmode=require). Required for v1. Server-only.
# Create the schema with `pnpm db:migrate`.
DATABASE_URL=postgres://aroma:placeholder@db.placeholder.invalid/aroma?sslmode=require
# Upstash Redis REST endpoint and token. Required for v1: rate limits, keeper leases, idempotency keys, caches.
# Server-only. Route-health checks return unknown without shared storage in production.
UPSTASH_REDIS_REST_URL=https://redis.placeholder.invalid
UPSTASH_REDIS_REST_TOKEN=placeholder-upstash-token
# Quote authorization secret (32+ random characters), stable across instances. Required for v1. Server-only.
AROMA_TRADE_SECRET=placeholder-trade-secret-replace-with-32-plus-random-chars
# Rotation: move the old value here and put a new AROMA_TRADE_SECRET above. Quotes signed with the old
# key keep verifying until they expire (about a minute). Remove it once no old quote can be in flight.
AROMA_TRADE_SECRET_PREVIOUS=
# Canonical HTTPS public origin for metadata, sitemap and HTTP redirects.
AROMA_SITE_URL=
# Exact comma-separated browser origins allowed to call the API. Do not use *.
# Native apps have no Origin header.
AROMA_ALLOWED_ORIGINS=
# Only enable behind a reverse proxy that overwrites forwarded protocol/IP headers (true|false).
# Vercel is automatically detected. Local development does not need this.
AROMA_TRUST_PROXY=false
# Server-only Jupiter API key for supported discovery and actual swap routes.
JUPITER_API_KEY=
# Server-only Pyth API key for real-time Hermes equity oracle reference feeds.
PYTH_API_KEY=
# Server-only Privy app secret.
PRIVY_APP_SECRET=
# Separate 32+ character server-only HMAC secret for wallet publishing challenges (creators, M5).
CREATOR_AUTH_SECRET=
# Bearer secret (32+ chars) for POST /api/v1/revalidate, which refreshes cached v1 market/research data.
AROMA_REVALIDATE_SECRET=
# Creator publishing (prototype): comma-separated, multi-use invites; never expose to clients.
# Replaced by single-use hashed invites in Postgres at M5.
CREATOR_INVITE_CODES=
# Identify the deployment operator and public support contact in policy pages.
AROMA_OPERATOR_NAME=
AROMA_SUPPORT_EMAIL=
# Jito Block Engine bundle endpoint for multi-transaction baskets (v1), e.g.
# https://mainnet.block-engine.jito.wtf/api/v1/bundles. Unset: v1 refuses baskets that need several
# transactions (no partial orders, no per-transaction fallback). Single-transaction orders are unaffected.
JITO_BLOCK_ENGINE_URL=
# Optional Jito authentication UUID. Standard public bundle endpoints work without one.
JITO_AUTH_UUID=
# Cap dynamic bundle tips; lamports, allowed range 1000..100000.
JITO_MAX_TIP_LAMPORTS=100000
# Optional server-side Sentry DSN (falls back to NEXT_PUBLIC_SENTRY_DSN). Blank disables Sentry (no-op).
SENTRY_DSN=
# Optional Sentry environment label, e.g. production | preview.
SENTRY_ENVIRONMENT=
# Optional Sentry auth token for source-map upload at build time (CI only). Never commit.
SENTRY_AUTH_TOKEN=

# ───────── Test switches (local `next start` only) ─────────
# Lets a local production build honour test-only switches (the Playwright outage server, M3).
# Leave false. Validation REJECTS true when VERCEL_ENV=production. Switches it unlocks always log a warning.
AROMA_V1_ALLOW_TEST_SWITCHES=false
# E2E only (honoured only while test switches are allowed): the genesis hash of a LOCAL fork that
# stands in for mainnet, and a loopback Jupiter stand-in. Both are rejected when VERCEL_ENV=production.
AROMA_V1_TEST_FORK_GENESIS=
AROMA_V1_TEST_JUPITER_URL=
# E2E BUILDS ONLY (build time): compiles in the Playwright test-wallet bridge, which holds no key.
# Leave false. Rejected when VERCEL_ENV=production; the client-secret scan fails a build that contains it.
NEXT_PUBLIC_AROMA_E2E_WALLET=false

# ───────── Devnet (test funds only; never share keys or endpoints with mainnet) ─────────
# The recurring backend is devnet-only and independently genesis-checked on prepare and broadcast.
# Mainnet spot trading uses SOLANA_RPC_URL above, never this one.
# Catalog/mints: apps/web/public/xstocks-devnet/xstocks.json (public metadata, not secrets).
AROMA_RECURRING_RPC_URL=https://api.devnet.solana.com
# Server-only HMAC secret (32+ characters), distinct from AROMA_TRADE_SECRET.
# Authorizes reviewed messages; this is not a wallet key and cannot spend tokens.
AROMA_RECURRING_AUTH_SECRET=
# Optional server-only devnet faucet keypair for distributing test KUSD and gas SOL.
# JSON array [1,2,3...] or 128-char hex string. Devnet only; never a mainnet wallet.
AROMA_FAUCET_SECRET_KEY=
# Optional dedicated devnet collector fee-payer JSON keypair for the PROTOTYPE collector (read directly,
# not validated by env.schema.ts). Never use a mainnet funding wallet. Replaced by apps/keeper at M6.
BOT_KEYPAIR=

# ───────── Recurring investing on devnet (/v1/invest, M7) ─────────
# The invest feature is devnet-only. It uses AROMA_RECURRING_RPC_URL above on the server (genesis-checked
# per client) and this endpoint in the browser (the wallet must report the devnet genesis).
NEXT_PUBLIC_SOLANA_DEVNET_RPC_URL=
# devnet (default) or localnet. localnet is for the local-validator E2E ONLY: it needs
# AROMA_V1_ALLOW_TEST_SWITCHES=true and a NEXT_PUBLIC_AROMA_LOCALNET=true build, and is refused in production.
AROMA_V1_INVEST_CLUSTER=devnet
NEXT_PUBLIC_AROMA_LOCALNET=false
AROMA_V1_LOCALNET_RPC_URL=
AROMA_V1_LOCALNET_GENESIS=
AROMA_V1_LOCALNET_FUNDING_MINT=
# Faucet (POST /api/v1/faucet): a devnet-only key that holds the test USD mint authority (NEVER the deployer),
# as a 64-byte JSON array. Server-only. Refused on any non-devnet genesis.
AROMA_V1_FAUCET_KEYPAIR=
# Cloudflare Turnstile. Locally and in tests use Cloudflare's published test keys
# (site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA); production refuses test secrets.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Claims allowed per UTC day across all wallets (default 200).
AROMA_V1_FAUCET_DAILY_CLAIMS=

# ───────── Keeper (apps/keeper, QStash; M6) ─────────
# Upstash QStash token used to publish and schedule keeper runs.
QSTASH_TOKEN=
# QStash signing keys; the keeper endpoint verifies every request signature with these (current + next for rotation).
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Collector bearer secret (32+ characters); separate from every other secret.
AROMA_RECURRING_EXECUTOR_SECRET=
# Optional HTTPS webhook (Slack/Discord) for failed or skipped installments and low fee-payer balance.
KEEPER_ALERT_WEBHOOK_URL=

# --- M9 compliance gate (additive; docs/launch/COMPLIANCE.md) ---
# All optional: unset = the policy defaults in features/compliance/policy.ts (US plus a
# placeholder list to confirm with counsel; a missing country fails closed; browse-only for
# restricted visitors; devnet plans and faucet blocked for them). The country comes from
# Vercel's x-vercel-ip-country, trusted only on Vercel or with AROMA_TRUST_PROXY=true.
# Local `next dev` has no trusted country: set AROMA_COMPLIANCE_MISSING_COUNTRY=allow in
# .env.local to quote locally. Production must keep `block` (pnpm check:prod-env refuses allow).
AROMA_COMPLIANCE_RESTRICTED_COUNTRIES=
AROMA_COMPLIANCE_MISSING_COUNTRY=
AROMA_COMPLIANCE_BROWSE=
AROMA_COMPLIANCE_DEVNET=
AROMA_TERMS_VERSION=
# --- end M9 compliance gate ---
