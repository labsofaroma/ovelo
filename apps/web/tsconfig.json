{
  // One configuration for all of apps/web (M9: the strict project is folded in; there is no
  // prototype code left to exempt). Base: strict, noUncheckedIndexedAccess, noImplicitOverride.
  "extends": "@aroma/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "jsx": "preserve",
    "incremental": true,
    "types": ["node"],
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next", ".next-e2e", ".next-e2e-invest"]
}
