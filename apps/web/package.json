{
  "name": "@aroma/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/check-env.ts && next build && node ../../scripts/check-client-secrets.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p tsconfig.strict.json && tsc --noEmit -p tsconfig.legacy-tests.json",
    "test": "pnpm run test:legacy && pnpm run test:unit",
    "test:legacy": "cd ../.. && TSX_TSCONFIG_PATH=apps/web/tsconfig.json node --import tsx --test apps/web/tests/*.test.* apps/web/tests/sdk/*.test.*",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:check": "drizzle-kit check",
    "check-env": "tsx scripts/check-env.ts"
  },
  "dependencies": {
    "@aroma/ui": "workspace:*",
    "@base-ui/react": "1.8.0",
    "@farcaster/mini-app-solana": "^1.0.0",
    "@gsap/react": "2.1.2",
    "@neondatabase/serverless": "1.2.0",
    "@privy-io/react-auth": "3.42.0",
    "@sentry/nextjs": "10.78.0",
    "@solana/actions": "1.6.6",
    "@solana/kit": "7.1.1",
    "@solana/spl-token": "^0.4.12",
    "@solana/subscriptions": "0.5.0",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-react-ui": "^0.9.35",
    "@solana/web3.js": "^1.98.0",
    "@tanstack/react-query": "5.102.8",
    "@upstash/ratelimit": "2.2.1",
    "@upstash/redis": "1.41.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "buffer": "^6.0.3",
    "drizzle-orm": "0.45.4",
    "gsap": "3.15.0",
    "lucide-react": "^0.468.0",
    "next": "15.5.24",
    "pino": "10.4.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "server-only": "0.0.1",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@aroma/config": "workspace:*",
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "0.5.16",
    "@next/env": "15.5.24",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "3.2.7",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "fast-check": "4.10.2",
    "jsdom": "^26.1.0",
    "msw": "2.15.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tailwindcss-v4": "npm:tailwindcss@^4.3.5",
    "tsx": "4.20.6",
    "typescript": "^5.7.3",
    "vitest": "3.2.7"
  }
}
